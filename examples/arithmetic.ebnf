(* Complete arithmetic grammar with S-expression-like structure *)
(* Uses RIGHT recursion (works with recursive descent parsers) *)
(* Each operation becomes its own node for clean transformation *)

expr = <ws>* add_sub <ws>* ;

(* Addition/subtraction level - hide the wrapper *)
<add_sub> = add | sub | mul_div ;

add = mul_div <ws>* <"+"> <ws>* add_sub ;
sub = mul_div <ws>* <"-"> <ws>* add_sub ;

(* Multiplication/division level - hide the wrapper *)
<mul_div> = mul | div | unary ;

mul = unary <ws>* <"*"> <ws>* mul_div ;
div = unary <ws>* <"/"> <ws>* mul_div ;

(* Unary operations *)
<unary> = neg | atom ;

neg = <"-"> <ws>* atom ;

(* Atomic terms - hide the wrapper *)
<atom> = number | <"("> <ws>* add_sub <ws>* <")"> ;

number = #"[0-9]+(\.[0-9]+)?" ;
<ws> = #"\s+" ;
