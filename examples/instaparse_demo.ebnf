(* Instaparse-style EBNF demonstration *)

(* Ordered choice (/) - PEG style, first match wins *)
expr = literal / variable / paren_expr ;

(* Literals take precedence *)
literal = number / string / boolean ;
number = #"-?[0-9]+(\.[0-9]+)?" ;
string = #"\"[^\"]*\"" ;
boolean = "true" | "false" ;  (* Unordered choice for simple alternatives *)

(* Variables and parentheses *)
variable = #"[a-zA-Z_][a-zA-Z0-9_]*" ;
paren_expr = <"("> <ws>* expr <ws>* <")"> ;

(* Statement with hidden whitespace *)
statement = assignment / expression_stmt ;
assignment = variable <ws>* <"="> <ws>* expr ;
expression_stmt = expr ;

(* Hidden whitespace rule *)
ws = #"\s+" ;

(* Program is a series of statements *)
program = (<ws>* statement <ws>* <";">)+ <ws>* ;