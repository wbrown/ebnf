(* JSON Grammar *)
(* Based on https://www.json.org/ specification *)

json = <ws>* value <ws>* ;

<value> = object
        | array
        | string
        | number
        | boolean
        | null ;

boolean = true | false ;

true = <"true"> ;

false = <"false"> ;

null = <"null"> ;

(* Object: { "key": value, ... } *)
object = <"{"> <ws>* <"}">
       | <"{"> <ws>* members <ws>* <"}"> ;

members = pair ( <ws>* <","> <ws>* pair )* ;

pair = string <ws>* <":"> <ws>* value ;

(* Array: [ value, value, ... ] *)
array = <"["> <ws>* <"]">
      | <"["> <ws>* elements <ws>* <"]"> ;

elements = value ( <ws>* <","> <ws>* value )* ;

(* String: "..." with escape sequences *)
(* Regex handles Unicode and escape sequences properly *)
string = <'"'> string_content <'"'> ;

<string_content> = #"([^\"\\]|\\[\"\\\/bfnrt]|\\u[0-9a-fA-F]{4})*" ;

(* Number: integer with optional fraction and exponent *)
number = int frac? exp? ;

int = "-"? ( "0" | [1-9] digit* ) ;

<digit> = [0-9] ;

frac = <"."> digit+ ;

exp = ( <"e"> | <"E"> ) ( <"+"> | <"-"> )? digit+ ;

(* Whitespace *)
ws = " " | "\t" | "\n" | "\r" ;
